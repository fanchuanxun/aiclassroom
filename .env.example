# ============================================================
# AIClassRoom — 环境变量示例
# 复制为 .env.local 后填写。.env*.local 已在 .gitignore 中，绝不进 Git。
# 这些是【服务端 Key】：只在 Node 侧使用，永不发送到浏览器。
# ============================================================

# OpenAI
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google (Gemini)
GOOGLE_GENERATIVE_AI_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# OpenAI 协议兼容 Provider（GLM / 通义千问 / Kimi / MiniMax / 硅基流动 / 豆包 / Grok）
# 填了这两个值后，provider 选 "openai-compatible" 即可使用
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# ------------------------------------------------------------
# 说明：
# 1. 上面全部留空也能启动项目；此时 /hello 等需要模型的页面会返回
#    PROVIDER_ERROR，并提示去「设置」里配置 Browser Key。
# 2. Browser Key 是用户在设置弹窗里填的密钥，存浏览器 IndexedDB，
#    每次请求随 body 传给服务端，服务端不落盘、不写日志。
# 3. 服务端环境变量优先级高于 Browser Key。
# ------------------------------------------------------------
